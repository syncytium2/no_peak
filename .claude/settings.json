{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Checking for concurrent sessions…"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Checking for concurrent sessions…"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"],
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  }
}
